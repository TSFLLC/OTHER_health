---2. Trigger to mask new / changed rows
CREATE TRIGGER trg_DimPatient_Mask
ON dbo.DimPatient
AFTER INSERT, UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    UPDATE p
    SET
        [DateOfBirth] = DATEFROMPARTS(
                            1940 + ABS(CHECKSUM(i.[PAT_DM_CSN_ID])) % 60,
                            1 + ABS(CHECKSUM(i.[PAT_DM_CSN_ID]*11)) % 12,
                            1 + ABS(CHECKSUM(i.[PAT_DM_CSN_ID]*17)) % 28),
        [ReligiousAffiliation] = 'Unknown',
        [Address 1: Street 1]  = 'Street ' + CAST(i.[PAT_DM_CSN_ID] AS VARCHAR(20)),
        [Address 1: Street 2]  = NULL,
        [Address1: City]       = 'City ' + CAST(i.[PAT_DM_CSN_ID] % 1000 AS VARCHAR(4)),
        [Address2: Zip]        = RIGHT(
                                     '00000' +
                                     CAST(ABS(CHECKSUM(i.[PAT_DM_CSN_ID])) % 99999 AS VARCHAR(5)),
                                     5),
        [PatientFirstName]     = 'FN' + RIGHT(
                                          CAST(ABS(CHECKSUM(i.[PAT_DM_CSN_ID])) AS VARCHAR(10)),
                                          4),
        [PatientLastName]      = 'LN' + RIGHT(
                                          CAST(ABS(CHECKSUM(i.[PAT_DM_CSN_ID]*7)) AS VARCHAR(10)),
                                          4),
        [Primary Email]        = 'user'
                                 + CAST(i.[PAT_DM_CSN_ID] AS VARCHAR(20))
                                 + '@example.com'
    FROM dbo.DimPatient p
    JOIN inserted i
      ON p.[PAT_DM_CSN_ID] = i.[PAT_DM_CSN_ID];
END;
GO


