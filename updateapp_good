CREATE TRIGGER S_cdpdynamics.trg_CDP_Appointments_Masking
ON S_cdpdynamics.CDP_Appointments
AFTER INSERT, UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    ;WITH ToMask AS
    (
        SELECT A.*
        FROM S_cdpdynamics.CDP_Appointments A
        INNER JOIN inserted i
            ON A.[appointmentID] = i.[appointmentID]
    )
    UPDATE A
    SET
        PatientFirstName = M.MaskedFirstName,
        PatientLastName  = M.MaskedLastName,
        MRN                        = M.MaskedMRN,
        VisitEncounterID           = M.MaskedVisitEncounterID,
