/*Part 2 — Daily Email Reports (SQL Agent + Database Mail)
We’ll create 2 email procedures (exactly what you asked for) and a 3rd general summary procedure that I recommend.
2.1 Helper: HTML table builder pattern
We’ll generate HTML with FOR XML PATH (simple and reliable).*/
=============2.2 Procedure: Report #1 (Failed logins + Table drops)+++++++++++++++++++++
USE [TERA];
GO

CREATE OR ALTER PROCEDURE dbo.usp_Email_AuditReport_Security
    @ProfileName SYSNAME,
    @Recipients  NVARCHAR(MAX),
    @HoursBack   INT = 24
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @StartTime DATETIME2(7) = DATEADD(HOUR, -@HoursBack, SYSUTCDATETIME());
    DECLARE @EndTime   DATETIME2(7) = SYSUTCDATETIME();

    DECLARE @html NVARCHAR(MAX) = N'<h2>Daily Security Audit Report</h2>'
        + N'<p>Window (UTC): ' + CONVERT(NVARCHAR(30), @StartTime, 126) + N' to ' + CONVERT(NVARCHAR(30), @EndTime, 126) + N'</p>';

    /* Failed logins */
    DECLARE @FailedLoginsHtml NVARCHAR(MAX);

    SELECT @FailedLoginsHtml =
        (SELECT
            td = CONVERT(NVARCHAR(30), event_time, 126), '',
            td = server_principal_name, '',
            td = client_ip, '',
            td = application_name, '',
            td = ISNULL(statement,N'')
         FROM dbo.v_Audit_FailedLogins
         WHERE event_time >= @StartTime AND event_time < @EndTime
         ORDER BY event_time DESC
         FOR XML PATH('tr'), TYPE
        ).value('.','nvarchar(max)');

    SET @html += N'<h3>Failed Logins</h3>'
        + CASE WHEN @FailedLoginsHtml IS NULL OR LEN(@FailedLoginsHtml)=0
               THEN N'<p><b>No failed logins in this window.</b></p>'
               ELSE N'<table border="1" cellspacing="0" cellpadding="4">'
                  + N'<tr><th>event_time</th><th>login</th><th>client_ip</th><th>app</th><th>statement</th></tr>'
                  + @FailedLoginsHtml + N'</table>'
          END;

    /* Table drops */
    DECLARE @DropsHtml NVARCHAR(MAX);

    SELECT @DropsHtml =
        (SELECT
            td = CONVERT(NVARCHAR(30), event_time, 126), '',
            td = server_principal_name, '',
            td = schema_name, '',
            td = object_name, '',
            td = ISNULL(statement,N'')
         FROM dbo.v_Audit_TableDrops
         WHERE event_time >= @StartTime AND event_time < @EndTime
         ORDER BY event_time DESC
         FOR XML PATH('tr'), TYPE
        ).value('.','nvarchar(max)');

    SET @html += N'<h3>Table / Object Drops</h3>'
        + CASE WHEN @DropsHtml IS NULL OR LEN(@DropsHtml)=0
               THEN N'<p><b>No DROP events in this window.</b></p>'
               ELSE N'<table border="1" cellspacing="0" cellpadding="4">'
                  + N'<tr><th>event_time</th><th>login</th><th>schema</th><th>object</th><th>statement</th></tr>'
                  + @DropsHtml + N'</table>'
          END;

    EXEC msdb.dbo.sp_send_dbmail
        @profile_name = @ProfileName,
        @recipients    = @Recipients,
        @subject       = 'Daily SQL Audit - Security (Failed Logins + Drops)',
        @body          = @html,
        @body_format   = 'HTML';
END
GO

++++++++++++++++2.3 Procedure: Report #2 (PHI SELECT access)++++++++++++++++++++++++
USE [TERA];
GO

CREATE OR ALTER PROCEDURE dbo.usp_Email_AuditReport_PHI_Selects
    @ProfileName SYSNAME,
    @Recipients  NVARCHAR(MAX),
    @HoursBack   INT = 24
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @StartTime DATETIME2(7) = DATEADD(HOUR, -@HoursBack, SYSUTCDATETIME());
    DECLARE @EndTime   DATETIME2(7) = SYSUTCDATETIME();

    DECLARE @html NVARCHAR(MAX) = N'<h2>Daily PHI Access Report (SELECT)</h2>'
        + N'<p>Window (UTC): ' + CONVERT(NVARCHAR(30), @StartTime, 126) + N' to ' + CONVERT(NVARCHAR(30), @EndTime, 126) + N'</p>';

    DECLARE @PhiHtml NVARCHAR(MAX);

    SELECT @PhiHtml =
        (SELECT
            td = CONVERT(NVARCHAR(30), event_time, 126), '',
            td = server_principal_name, '',
            td = database_principal_name, '',
            td = schema_name, '',
            td = object_name, '',
            td = client_ip, '',
            td = application_name, '',
            td = LEFT(ISNULL(statement,N''), 4000)
         FROM dbo.v_Audit_PHI_Selects
         WHERE event_time >= @StartTime AND event_time < @EndTime
         ORDER BY event_time DESC
         FOR XML PATH('tr'), TYPE
        ).value('.','nvarchar(max)');

    SET @html += CASE WHEN @PhiHtml IS NULL OR LEN(@PhiHtml)=0
               THEN N'<p><b>No PHI SELECT activity in this window.</b></p>'
               ELSE N'<table border="1" cellspacing="0" cellpadding="4">'
                  + N'<tr><th>event_time</th><th>login</th><th>db_user</th><th>schema</th><th>object</th><th>client_ip</th><th>app</th><th>statement (truncated)</th></tr>'
                  + @PhiHtml + N'</table>'
          END;

    EXEC msdb.dbo.sp_send_dbmail
        @profile_name = @ProfileName,
        @recipients    = @Recipients,
        @subject       = 'Daily SQL Audit - PHI SELECT Access',
        @body          = @html,
        @body_format   = 'HTML';
END
GO


++++++++++++++++2.4 (Recommended) Procedure: Report #3 (General summary)++++++++++++++++++++++++++++++++++
USE [TERA];
GO

CREATE OR ALTER PROCEDURE dbo.usp_Email_AuditReport_Summary
    @ProfileName SYSNAME,
    @Recipients  NVARCHAR(MAX),
    @HoursBack   INT = 24
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @StartTime DATETIME2(7) = DATEADD(HOUR, -@HoursBack, SYSUTCDATETIME());
    DECLARE @EndTime   DATETIME2(7) = SYSUTCDATETIME();

    DECLARE @html NVARCHAR(MAX) = N'<h2>Daily SQL Audit Summary</h2>'
        + N'<p>Window (UTC): ' + CONVERT(NVARCHAR(30), @StartTime, 126) + N' to ' + CONVERT(NVARCHAR(30), @EndTime, 126) + N'</p>';

    DECLARE @SummaryHtml NVARCHAR(MAX);

    SELECT @SummaryHtml =
        (SELECT
            td = action_id, '',
            td = COUNT(*)
         FROM dbo.v_Audit_All
         WHERE event_time >= @StartTime AND event_time < @EndTime
         GROUP BY action_id
         ORDER BY COUNT(*) DESC
         FOR XML PATH('tr'), TYPE
        ).value('.','nvarchar(max)');

    SET @html += N'<h3>Event Counts by Action</h3>'
        + N'<table border="1" cellspacing="0" cellpadding="4">'
        + N'<tr><th>action_id</th><th>count</th></tr>'
        + ISNULL(@SummaryHtml, N'')
        + N'</table>';

    EXEC msdb.dbo.sp_send_dbmail
        @profile_name = @ProfileName,
        @recipients    = @Recipients,
        @subject       = 'Daily SQL Audit - General Summary',
        @body          = @html,
        @body_format   = 'HTML';
END
GO


