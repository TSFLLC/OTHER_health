++++dynamic masking for Identity serID+++++++++++++++++++++
USE [TERA];
GO

/* IdentityId (nvarchar / identifier) */
ALTER TABLE [B_epic].[IdentitySerId]
ALTER COLUMN [IdentityId]
ADD MASKED WITH (FUNCTION = 'partial(0,"XXXXXXX",4)');
GO

/* MPI ID From Date */
ALTER TABLE [B_epic].[IdentitySerId]
ALTER COLUMN [MpiIdFromDate]
ADD MASKED WITH (FUNCTION = 'default()');
GO

/* MPI ID To Date */
ALTER TABLE [B_epic].[IdentitySerId]
ALTER COLUMN [MpiIdToDate]
ADD MASKED WITH (FUNCTION = 'default()');
GO

+++++++++++++++++++++++++///Rollback++++++++++++++++++++++++++++++++++++

ALTER TABLE [B_epic].[IdentitySerId] ALTER COLUMN [IdentityId] DROP MASKED;
ALTER TABLE [B_epic].[IdentitySerId] ALTER COLUMN [MpiIdFromDate] DROP MASKED;
ALTER TABLE [B_epic].[IdentitySerId] ALTER COLUMN [MpiIdToDate] DROP MASKED;
GO

