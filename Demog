            ),
            7
        ),

    PrimaryPhone =
        '555' +
        RIGHT(
            '0000000' +
            CAST(
                ABS(CAST(CHECKSUM(CONVERT(varchar(30), p.PAT_ENC_CSN_ID) + '_PP') AS BIGINT)) % 10000000
                AS varchar(7)
            ),
            7
        ),

    SecondaryPhone =
        '555' +
        RIGHT(
            '0000000' +
            CAST(
                ABS(CAST(CHECKSUM(CONVERT(varchar(30), p.PAT_ENC_CSN_ID) + '_SP') AS BIGINT)) % 10000000
