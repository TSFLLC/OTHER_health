UPDATE p
SET
    /* -------- DOB -------- */
    DateofBirth =
        DATEADD(
            DAY,
            ABS(CAST(CHECKSUM(CONVERT(varchar(30), p.PAT_ENC_CSN_ID)) AS BIGINT)) % 25550,
            CONVERT(date, '1940-01-01')
        ),

    /* -------- OPTIONAL: RELIGION (remove if you don’t want to touch it) -------- */
    ReligiousAffiliation =
        CASE ABS(CAST(CHECKSUM(CONVERT(varchar(30), p.PAT_ENC_CSN_ID) + '_REL') AS BIGINT)) % 6
            WHEN 0 THEN 'Unknown'
            WHEN 1 THEN 'Christian'
            WHEN 2 THEN 'Muslim'
            WHEN 3 THEN 'Jewish'
            WHEN 4 THEN 'Hindu'
            WHEN 5 THEN 'Other'
        END,

    /* -------- ADDRESSES -------- */
    [Address 1: Street 1] =
        CAST(
            100 + (
                ABS(CAST(CHECKSUM(CONVERT(varchar(30), p.PAT_ENC_CSN_ID) + '_S1') AS BIGINT)) % 9000
            ) AS varchar(5)
        )
        + ' ' +
        CASE ABS(CAST(CHECKSUM(CONVERT(varchar(30), p.PAT_ENC_CSN_ID) + '_S1NAME') AS BIGINT)) % 5
            WHEN 0 THEN 'Oak St'
            WHEN 1 THEN 'Maple Ave'
            WHEN 2 THEN 'Pine Dr'
            WHEN 3 THEN 'Cedar Ln'
            WHEN 4 THEN 'Elm St'
        END,

    [Address 2: Street 2] =
        CASE
            WHEN ABS(CAST(CHECKSUM(CONVERT(varchar(30), p.PAT_ENC_CSN_ID) + '_APTFLAG') AS BIGINT)) % 3 = 0
                THEN 'Apt ' +
                     CAST(
                         1 + (
                             ABS(CAST(CHECKSUM(CONVERT(varchar(30), p.PAT_ENC_CSN_ID) + '_APT') AS BIGINT)) % 200
                         ) AS varchar(4)
                     )
            ELSE 'Suite ' +
                 CAST(
                     1 + (
                         ABS(CAST(CHECKSUM(CONVERT(varchar(30), p.PAT_ENC_CSN_ID) + '_SUITE') AS BIGINT)) % 300
                     ) AS varchar(4)
                 )
        END,

    [Address 1: City] =
        CASE ABS(CAST(CHECKSUM(CONVERT(varchar(30), p.PAT_ENC_CSN_ID) + '_CITY') AS BIGINT)) % 6
            WHEN 0 THEN 'Houston'
            WHEN 1 THEN 'Dallas'
            WHEN 2 THEN 'Austin'
            WHEN 3 THEN 'San Antonio'
            WHEN 4 THEN 'Fort Worth'
            WHEN 5 THEN 'El Paso'
        END,

    [Address 1: Zip] =
        RIGHT(
            '00000' +
            CAST(
                70000 + (
                    ABS(CAST(CHECKSUM(CONVERT(varchar(30), p.PAT_ENC_CSN_ID) + '_ZIP1') AS BIGINT)) % 999
                ) AS varchar(5)
            ),
            5
        ),

    /* -------- NAMES -------- */
    PatientFirstName =
        CASE ABS(CAST(CHECKSUM(CONVERT(varchar(30), p.PAT_ENC_CSN_ID) + '_FN') AS BIGINT)) % 10
