            RIGHT('0000000000' + CAST(ABS(CHECKSUM('M', S.Seed)) AS VARCHAR(10)), 10) AS MaskedMobilePhone,
            RIGHT('0000000000' + CAST(ABS(CHECKSUM('P', S.Seed)) AS VARCHAR(10)), 10) AS MaskedPreferredPhone,

            LOWER(
                CASE S.Seed % 10
