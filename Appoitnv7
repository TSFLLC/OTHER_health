/*========================================================
  STATIC MASKING (UPDATED FOR V7)
  TABLE : TERA.S_cdpdynamics.CDP_appointmentsV7
  SEED  : AppointmentID
  NOTE  : MRN is NOT masked
=========================================================*/

UPDATE A
SET
    -- Patient identifiers (MRN intentionally NOT masked)
    PatientFirstName        = M.MaskedFirstName,
    PatientLastName         = M.MaskedLastName,
    PatientMI               = M.MaskedMI,
    PatientNameSuffix       = M.MaskedSuffix,
    PatientEmailAddress     = M.MaskedEmail,

    -- Address
    PatientHomeAddress1        = M.MaskedAddress1,
    PatientHomeAddressCity     = M.MaskedCity,
    PatientHomeAddressState    = M.MaskedState,
    PatientHomeAddressZipcode  = M.MaskedZip,
    PatientHomeAddressCounty   = M.MaskedCounty,

    -- Phones
    HomePhone       = M.MaskedHomePhone,
    WorkPhone       = M.MaskedWorkPhone,
    MobilePhone     = M.MaskedMobilePhone,
    PreferredPhone  = M.MaskedPreferredPhone,

    -- Demographics
    PatientGender      = M.MaskedGender,
    PatientDateofBirth = M.MaskedDOB,

    -- Visit / appointment reason (can leak PHI)
    VisitReasonCode        = M.MaskedVisitReasonCode,
    VisitReasonDescription = M.MaskedVisitReasonDesc,

    -- Appointment details (can leak PHI)
    AppointmentDescription = M.MaskedApptDesc,
    AppointmentComment     = M.MaskedApptComment,

    -- IDs / join keys (tokenize but DO NOT touch AppointmentID)
    VisitencounterID     = M.MaskedVisitEncounterID,
    VisitEncountersID    = M.MaskedVisitEncountersID,

    -- Epic created/updated timestamps (shift deterministically)
    EpicAppointmentsCreatedOn = M.MaskedEpicCreatedOn,
    LastUpdated              = M.MaskedLastUpdated,

    -- Referrals (note: column has a space)
    [Referral code]        = M.MaskedReferralCode,
    Referralcreatedondate  = M.MaskedReferralCreatedOn,

    -- Providers (names + NPIs are sensitive identifiers)
    PatientPrimaryCarePhysician = M.MaskedPCPName,
    PrimaryCarePhysicianNPI     = M.MaskedPCPNPI,

    ReferringPhysicianID        = M.MaskedRefPhysID,
    ReferringPhysician          = M.MaskedRefPhysName,
    ReferringPhysicianNPI       = M.MaskedRefPhysNPI,

    OrderingPhysician           = M.MaskedOrdPhysName,
    OrderingPhysicianNPI        = M.MaskedOrdPhysNPI,

    -- User identifier
    UserName                    = M.MaskedUserName

FROM TERA.S_cdpdynamics.CDP_appointmentsV7 AS A
CROSS APPLY (SELECT ABS(CHECKSUM(A.AppointmentID)) AS Seed) AS S
CROSS APPLY
(
    SELECT
        ------------------------------------------------------------
        -- NAMES
        ------------------------------------------------------------
        CASE S.Seed % 10
            WHEN 0 THEN 'James' WHEN 1 THEN 'Mary' WHEN 2 THEN 'Robert' WHEN 3 THEN 'Patricia' WHEN 4 THEN 'John'
            WHEN 5 THEN 'Jennifer' WHEN 6 THEN 'Michael' WHEN 7 THEN 'Linda' WHEN 8 THEN 'David' ELSE 'Sarah'
        END AS MaskedFirstName,

        CASE (S.Seed / 10) % 10
            WHEN 0 THEN 'Smith' WHEN 1 THEN 'Johnson' WHEN 2 THEN 'Brown' WHEN 3 THEN 'Williams' WHEN 4 THEN 'Jones'
            WHEN 5 THEN 'Garcia' WHEN 6 THEN 'Miller' WHEN 7 THEN 'Davis' WHEN 8 THEN 'Lopez' ELSE 'Taylor'
        END AS MaskedLastName,

        CHAR(65 + (S.Seed % 26)) AS MaskedMI,
        CASE (S.Seed / 100) % 4
            WHEN 0 THEN 'Jr' WHEN 1 THEN 'Sr' WHEN 2 THEN 'II' ELSE 'III'
        END AS MaskedSuffix,

        ------------------------------------------------------------
        -- ADDRESS
        ------------------------------------------------------------
        CASE S.Seed % 5
            WHEN 0 THEN '123 Main St'
            WHEN 1 THEN '456 Oak Ave'
            WHEN 2 THEN '789 Pine Road'
            WHEN 3 THEN '321 Maple Drive'
            ELSE '654 Elm Street'
        END AS MaskedAddress1,

        CASE (S.Seed / 5) % 5
            WHEN 0 THEN 'Houston'
            WHEN 1 THEN 'Dallas'
            WHEN 2 THEN 'Austin'
            WHEN 3 THEN 'San Antonio'
            ELSE 'Fort Worth'
        END AS MaskedCity,

        CASE (S.Seed / 25) % 4
            WHEN 0 THEN 'TX'
            WHEN 1 THEN 'OK'
            WHEN 2 THEN 'LA'
            ELSE 'NM'
        END AS MaskedState,

        CAST(10000 + (S.Seed % 90000) AS INT) AS MaskedZip,

        CASE (S.Seed / 50) % 5
            WHEN 0 THEN 'Harris'
            WHEN 1 THEN 'Dallas'
            WHEN 2 THEN 'Travis'
            WHEN 3 THEN 'Bexar'
            ELSE 'Tarrant'
        END AS MaskedCounty,

        ------------------------------------------------------------
        -- PHONES
        ------------------------------------------------------------
        RIGHT('0000000000' + CAST(ABS(CHECKSUM('H', S.Seed)) AS VARCHAR(10)), 10) AS MaskedHomePhone,
        RIGHT('0000000000' + CAST(ABS(CHECKSUM('W', S.Seed)) AS VARCHAR(10)), 10) AS MaskedWorkPhone,
        RIGHT('0000000000' + CAST(ABS(CHECKSUM('M', S.Seed)) AS VARCHAR(10)), 10) AS MaskedMobilePhone,
        RIGHT('0000000000' + CAST(ABS(CHECKSUM('P', S.Seed)) AS VARCHAR(10)), 10) AS MaskedPreferredPhone,

        ------------------------------------------------------------
        -- EMAIL
        ------------------------------------------------------------
        LOWER(
            CASE S.Seed % 10
                WHEN 0 THEN 'james' WHEN 1 THEN 'mary' WHEN 2 THEN 'robert' WHEN 3 THEN 'patricia' WHEN 4 THEN 'john'
                WHEN 5 THEN 'jennifer' WHEN 6 THEN 'michael' WHEN 7 THEN 'linda' WHEN 8 THEN 'david' ELSE 'sarah'
            END + '.' +
            CASE (S.Seed / 10) % 10
                WHEN 0 THEN 'smith' WHEN 1 THEN 'johnson' WHEN 2 THEN 'brown' WHEN 3 THEN 'williams' WHEN 4 THEN 'jones'
                WHEN 5 THEN 'garcia' WHEN 6 THEN 'miller' WHEN 7 THEN 'davis' WHEN 8 THEN 'lopez' ELSE 'taylor'
            END + '@examplemail.com'
        ) AS MaskedEmail,

        ------------------------------------------------------------
        -- DOB + Gender
        ------------------------------------------------------------
        DATEFROMPARTS(
            1940 + (S.Seed % 60),
            1 + ((S.Seed / 100) % 12),
            1 + ((S.Seed / 1000) % 28)
        ) AS MaskedDOB,

        CASE S.Seed % 3
            WHEN 0 THEN 'F'
            WHEN 1 THEN 'M'
            ELSE 'U'
        END AS MaskedGender,

        ------------------------------------------------------------
        -- Visit reason
        ------------------------------------------------------------
        CAST(1000 + (S.Seed % 9000) AS INT) AS MaskedVisitReasonCode,
        'General consultation (masked)'     AS MaskedVisitReasonDesc,

        ------------------------------------------------------------
        -- Appointment text
        ------------------------------------------------------------
        'Routine visit (masked)' AS MaskedApptDesc,
        CAST(100000 + (S.Seed % 900000) AS INT) AS MaskedApptComment,

        ------------------------------------------------------------
        -- Join keys
        ------------------------------------------------------------
        CAST(ABS(CHECKSUM('VEID',  S.Seed)) AS BIGINT) AS MaskedVisitEncounterID,
        CAST(ABS(CHECKSUM('VECID', S.Seed)) AS BIGINT) AS MaskedVisitEncountersID,

        ------------------------------------------------------------
        -- Referrals
        ------------------------------------------------------------
        CAST(ABS(CHECKSUM('REF', S.Seed)) AS BIGINT) AS MaskedReferralCode,

        DATEADD(DAY, (S.Seed % 365),
            ISNULL(A.Referralcreatedondate, CAST('2018-01-01' AS DATE))
        ) AS MaskedReferralCreatedOn,

        ------------------------------------------------------------
        -- Created/updated timestamps
        ------------------------------------------------------------
        DATEADD(DAY, (S.Seed % 365),
            ISNULL(CAST(A.EpicAppointmentsCreatedOn AS DATETIME), CAST('2018-01-01' AS DATETIME))
        ) AS MaskedEpicCreatedOn,

        DATEADD(DAY, (S.Seed % 365),
            ISNULL(CAST(A.LastUpdated AS DATETIME), CAST('2018-01-01' AS DATETIME))
        ) AS MaskedLastUpdated,

        ------------------------------------------------------------
        -- Providers + NPIs
        ------------------------------------------------------------
        'Dr. ' +
        CASE (S.Seed / 7) % 10
            WHEN 0 THEN 'Adams' WHEN 1 THEN 'Baker' WHEN 2 THEN 'Clark' WHEN 3 THEN 'Davis' WHEN 4 THEN 'Evans'
            WHEN 5 THEN 'Frank' WHEN 6 THEN 'Green' WHEN 7 THEN 'Hill' WHEN 8 THEN 'Irwin' ELSE 'Jones'
        END AS MaskedPCPName,

        RIGHT('0000000000' + CAST(ABS(CHECKSUM('PCPNPI', S.Seed)) AS VARCHAR(20)), 10) AS MaskedPCPNPI,

        CAST(ABS(CHECKSUM('REFID', S.Seed)) AS BIGINT) AS MaskedRefPhysID,

        'Dr. ' +
        CASE (S.Seed / 11) % 10
            WHEN 0 THEN 'King' WHEN 1 THEN 'Lewis' WHEN 2 THEN 'Moore' WHEN 3 THEN 'Nelson' WHEN 4 THEN 'Owens'
            WHEN 5 THEN 'Parker' WHEN 6 THEN 'Quinn' WHEN 7 THEN 'Reed' WHEN 8 THEN 'Scott' ELSE 'Turner'
        END AS MaskedRefPhysName,

        RIGHT('0000000000' + CAST(ABS(CHECKSUM('REFNPI', S.Seed)) AS VARCHAR(20)), 10) AS MaskedRefPhysNPI,

        'Dr. ' +
        CASE (S.Seed / 13) % 10
            WHEN 0 THEN 'Underwood' WHEN 1 THEN 'Vega' WHEN 2 THEN 'White' WHEN 3 THEN 'Xavier' WHEN 4 THEN 'Young'
            WHEN 5 THEN 'Zimmer' WHEN 6 THEN 'Carter' WHEN 7 THEN 'Diaz' WHEN 8 THEN 'Edwards' ELSE 'Foster'
        END AS MaskedOrdPhysName,

        RIGHT('0000000000' + CAST(ABS(CHECKSUM('ORDNPI', S.Seed)) AS VARCHAR(20)), 10) AS MaskedOrdPhysNPI,

        ------------------------------------------------------------
        -- UserName
        ------------------------------------------------------------
        'user' + RIGHT('000000' + CAST(S.Seed % 1000000 AS VARCHAR(6)), 6) AS MaskedUserName
) AS M;
GO

