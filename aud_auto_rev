/* =========================
   5) SQL Agent Job (Daily)
   - Recreate job cleanly
   (EDIT profile/recipients)
   ========================= */
USE msdb;
GO

IF EXISTS (SELECT 1 FROM msdb.dbo.sysjobs WHERE name = N'Daily_TERA_Audit_Reports')
