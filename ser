++++++++++++++++++++++++Masking++++++++++++++++++++++++++++++++++++++++++
USE [TERA];
GO

UPDATE T
SET
    /* =========================
       CRITICAL
       ========================= */

    -- SSN: keep last 4
    Ssn = CASE
        WHEN T.Ssn IS NULL THEN NULL
        ELSE REPLICATE('X', CASE WHEN LEN(CONVERT(nvarchar(4000), T.Ssn)) > 4 THEN LEN(CONVERT(nvarchar(4000), T.Ssn)) - 4 ELSE 0 END)
             + RIGHT(CONVERT(nvarchar(4000), T.Ssn), 4)
    END,

    -- DEA: keep last 3
    Deanumber = CASE
        WHEN T.Deanumber IS NULL THEN NULL
        ELSE REPLICATE('X', CASE WHEN LEN(CONVERT(nvarchar(4000), T.Deanumber)) > 3 THEN LEN(CONVERT(nvarchar(4000), T.Deanumber)) - 3 ELSE 0 END)
             + RIGHT(CONVERT(nvarchar(4000), T.Deanumber), 3)
    END,

    -- Birthdate: deterministic shift to non-real date (keeps date type)
    Birthdate = CASE
        WHEN T.Birthdate IS NULL THEN NULL
        ELSE DATEADD(day, (ABS(CHECKSUM(CONCAT(CONVERT(varchar(30), T.Birthdate, 126), '|DOB'))) % 3650), CONVERT(date, '1950-01-01'))
    END,

    /* =========================
       HIGH
       ========================= */

    -- Email: mask local part, keep domain (e.g., xxx@domain.com)
    Email = CASE
        WHEN T.Email IS NULL THEN NULL
        WHEN CHARINDEX('@', CONVERT(nvarchar(4000), T.Email)) > 1
            THEN CONCAT('xxx@', RIGHT(CONVERT(nvarchar(4000), T.Email), LEN(CONVERT(nvarchar(4000), T.Email)) - CHARINDEX('@', CONVERT(nvarchar(4000), T.Email))))
        ELSE 'xxx@masked.local'
    END,

    -- Office phone: keep last 4 digits
    Officephonenum = CASE
        WHEN T.Officephonenum IS NULL THEN NULL
        ELSE REPLICATE('X', CASE WHEN LEN(CONVERT(nvarchar(4000), T.Officephonenum)) > 4 THEN LEN(CONVERT(nvarchar(4000), T.Officephonenum)) - 4 ELSE 0 END)
             + RIGHT(CONVERT(nvarchar(4000), T.Officephonenum), 4)
    END,

    -- Office fax: keep last 4 digits
    Officefaxnum = CASE
        WHEN T.Officefaxnum IS NULL THEN NULL
        ELSE REPLICATE('X', CASE WHEN LEN(CONVERT(nvarchar(4000), T.Officefaxnum)) > 4 THEN LEN(CONVERT(nvarchar(4000), T.Officefaxnum)) - 4 ELSE 0 END)
             + RIGHT(CONVERT(nvarchar(4000), T.Officefaxnum), 4)
    END,

    -- NurseEmpId: if numeric -> pseudo-number; else keep last 4
    Nurseempid = CASE
        WHEN T.Nurseempid IS NULL THEN NULL
        WHEN TRY_CONVERT(bigint, T.Nurseempid) IS NOT NULL
            THEN CONVERT(bigint, ABS(CHECKSUM(CONCAT(CONVERT(varchar(50), T.Nurseempid), '|EMP'))))
        ELSE
            REPLICATE('X', CASE WHEN LEN(CONVERT(nvarchar(4000), T.Nurseempid)) > 4 THEN LEN(CONVERT(nvarchar(4000), T.Nurseempid)) - 4 ELSE 0 END)
            + RIGHT(CONVERT(nvarchar(4000), T.Nurseempid), 4)
    END,

    -- UserId: keep last 4
    Userid = CASE
        WHEN T.Userid IS NULL THEN NULL
        ELSE REPLICATE('X', CASE WHEN LEN(CONVERT(nvarchar(4000), T.Userid)) > 4 THEN LEN(CONVERT(nvarchar(4000), T.Userid)) - 4 ELSE 0 END)
             + RIGHT(CONVERT(nvarchar(4000), T.Userid), 4)
    END,

    -- UPIN: keep last 3
    Upin = CASE
        WHEN T.Upin IS NULL THEN NULL
        ELSE REPLICATE('X', CASE WHEN LEN(CONVERT(nvarchar(4000), T.Upin)) > 3 THEN LEN(CONVERT(nvarchar(4000), T.Upin)) - 3 ELSE 0 END)
             + RIGHT(CONVERT(nvarchar(4000), T.Upin), 3)
    END,

    -- Medicare provider id: keep last 4
    Medicareprovid = CASE
        WHEN T.Medicareprovid IS NULL THEN NULL
        ELSE REPLICATE('X', CASE WHEN LEN(CONVERT(nvarchar(4000), T.Medicareprovid)) > 4 THEN LEN(CONVERT(nvarchar(4000), T.Medicareprovid)) - 4 ELSE 0 END)
             + RIGHT(CONVERT(nvarchar(4000), T.Medicareprovid), 4)
    END,

    -- Medicaid provider id: keep last 4
    Medicaidprovid = CASE
        WHEN T.Medicaidprovid IS NULL THEN NULL
        ELSE REPLICATE('X', CASE WHEN LEN(CONVERT(nvarchar(4000), T.Medicaidprovid)) > 4 THEN LEN(CONVERT(nvarchar(4000), T.Medicaidprovid)) - 4 ELSE 0 END)
             + RIGHT(CONVERT(nvarchar(4000), T.Medicaidprovid), 4)
    END
FROM [B_epic].[ClaritySer] T;
