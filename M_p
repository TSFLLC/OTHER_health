+++++++++++++++++++++++Safe rollback ++++++++++++++++++++++++++++++++++++++++++++++++
USE TERA;
GO

DECLARE @SchemaName sysname = N'B_epic';
DECLARE @TableName  sysname = N'Patient';

DECLARE @sql nvarchar(max) = N'';

;WITH MaskedCols AS
(
    SELECT
        s.name  AS SchemaName,
        t.name  AS TableName,
        c.name  AS ColumnName
    FROM sys.tables t
    JOIN sys.schemas s
        ON s.schema_id = t.schema_id
    JOIN sys.columns c
        ON c.object_id = t.object_id
    WHERE s.name = @SchemaName
      AND t.name = @TableName
      AND c.is_masked = 1
      AND c.name IN
      (
        N'PAT_MRN_ID',
        N'SSN',
        N'PATIENTFIRSTNAME',
        N'PATIENTLASTNAME',
        N'BIRTH_DATE',
        N'HOME_PHONE',
        N'EMAIL_ADDRESS',
        N'ADD_LINE_1',
        N'CITY',
        N'STATE_C',
        N'ZIP'
      )
)
SELECT @sql +=
    N'ALTER TABLE ' + QUOTENAME(SchemaName) + N'.' + QUOTENAME(TableName) +
    N' ALTER COLUMN ' + QUOTENAME(ColumnName) + N' DROP MASKED;' + CHAR(13) + CHAR(10)
FROM MaskedCols
ORDER BY ColumnName;

IF @sql = N''
BEGIN
    PRINT 'No masking found for the specified columns on ' + QUOTENAME(@SchemaName) + '.' + QUOTENAME(@TableName) + '. Nothing to rollback.';
END
ELSE
BEGIN
    PRINT 'Running rollback script:';
    PRINT @sql;
    EXEC sp_executesql @sql;
    PRINT 'Rollback completed.';
END
GO





