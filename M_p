----------------//check what colunm is currently mask-------------------
SELECT
    t.name  AS TableName,
    c.name  AS ColumnName,
    c.is_masked,
    mc.masking_function
FROM sys.tables t
JOIN sys.columns c
    ON c.object_id = t.object_id
LEFT JOIN sys.masked_columns mc
    ON mc.object_id = c.object_id
   AND mc.column_id = c.column_id
WHERE t.object_id = OBJECT_ID('[B_epic].[Patient]')
  AND c.is_masked = 1
ORDER BY c.column_id;

