CREATE OR ALTER TRIGGER S_cdpdynamics.trg_CalllogReport_Mask
ON [S_cdpdynamics].[CalllogReport]
AFTER INSERT
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @IncludeModerate bit =
    (
        SELECT IncludeModerate
        FROM S_cdpdynamics.MaskingConfig
        WHERE TableSchema = 'S_cdpdynamics' AND TableName = 'CalllogReport'
    );

    UPDATE c
    SET
        /* CRITICAL (ALWAYS MASK) */
        CustomerName = 'Masked Customer',
        FirstName    = 'John',
        LastName     = 'Doe',
        Email        = CONCAT('user', ABS(CHECKSUM(NEWID())) % 100000, '@example.com'),

        Ani          = CONCAT('555', RIGHT('0000000' + CAST(ABS(CHECKSUM(NEWID())) % 10000000 AS varchar(7)), 7)),
        Dnis         = CONCAT('555', RIGHT('0000000' + CAST(ABS(CHECKSUM(NEWID())) % 10000000 AS varchar(7)), 7)),
        Number1      = CONCAT('555', RIGHT('0000000' + CAST(ABS(CHECKSUM(NEWID())) % 10000000 AS varchar(7)), 7)),
        Number2      = CONCAT('555', RIGHT('0000000' + CAST(ABS(CHECKSUM(NEWID())) % 10000000 AS varchar(7)), 7)),
        Number3      = CONCAT('555', RIGHT('0000000' + CAST(ABS(CHECKSUM(NEWID())) % 10000000 AS varchar(7)), 7)),
        AttendanceLine = CONCAT('555', RIGHT('0000000' + CAST(ABS(CHECKSUM(NEWID())) % 10000000 AS varchar(7)), 7)),
        [Ardent.callbackNumber] = CONCAT('555', RIGHT('0000000' + CAST(ABS(CHECKSUM(NEWID())) % 10000000 AS varchar(7)), 7)),
        [Studio.patientAni]     = CONCAT('555', RIGHT('0000000' + CAST(ABS(CHECKSUM(NEWID())) % 10000000 AS varchar(7)), 7)),

        ContactId          = ABS(CHECKSUM(NEWID())) % 100000000,
        [Studio.patientId] = ABS(CHECKSUM(NEWID())) % 100000000,

        Street = '123 Masked St',
        City   = 'MaskedCity',
        State  = 'XX',
        Zip    = '00000',

        Notes = 'Masked',
        [Studio.intentTranscript] = 'Masked',
        CallSurveyResult = 'Masked',

        /* MODERATE (OPTIONAL) */
        AgentFirstName     = CASE WHEN @IncludeModerate = 1 THEN 'Agent' ELSE c.AgentFirstName END,
        AgentLastName      = CASE WHEN @IncludeModerate = 1 THEN 'User'  ELSE c.AgentLastName  END,
        AgentName          = CASE WHEN @IncludeModerate = 1 THEN 'Agent User' ELSE c.AgentName END,
        DestAgentFirstName = CASE WHEN @IncludeModerate = 1 THEN 'Agent' ELSE c.DestAgentFirstName END,
        DestAgentLastName  = CASE WHEN @IncludeModerate = 1 THEN 'User'  ELSE c.DestAgentLastName  END,
        DestAgentName      = CASE WHEN @IncludeModerate = 1 THEN 'Agent User' ELSE c.DestAgentName END,
        AgentEmail         = CASE WHEN @IncludeModerate = 1 THEN CONCAT('agent', ABS(CHECKSUM(NEWID())) % 100000, '@company.com') ELSE c.AgentEmail END,
        DestAgentEmail     = CASE WHEN @IncludeModerate = 1 THEN CONCAT('agent', ABS(CHECKSUM(NEWID())) % 100000, '@company.com') ELSE c.DestAgentEmail END

    FROM [S_cdpdynamics].[CalllogReport] c
    INNER JOIN inserted i
        ON c.CallId = i.CallId;
END;
