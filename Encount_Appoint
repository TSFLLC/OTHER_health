        PrimaryCareProviderNPI  = M.MaskedPCProvNPI,

        VisitProviderID         = M.MaskedVisitProvID,
        VisitProviderName       = M.MaskedVisitProvValue,
        VisitProviderNPI        = M.MaskedVisitProvNPI,

        AdmissionProviderID     = M.MaskedAdmissionProvID,
        AdmissionProviderName   = M.MaskedAdmissionProvValue,
