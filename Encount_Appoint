/*========================================================
  STATIC MASKING (CRITICAL ONLY)
  TABLE : S_cdpdynamics.CDP_ENCOUNTERS
  SEED  : EncounterId
=========================================================*/

UPDATE E
SET
    -- identifiers
    MRN                 = M.MaskedMRN,
    -- EncounterId       = M.MaskedEncounterId,  -- optional; keep key by default
    EncounterLine        = M.MaskedEncounterLine,

    -- dates of care
    EncounterDate        = M.MaskedEncounterDate,
    AdmissionDateTime    = M.MaskedAdmissionDateTime,
    DischargeDateTime    = M.MaskedDischargeDateTime,
    EpicEncountersCreatedOn = M.MaskedEpicEncountersCreatedOn,

    -- clinical codes / reasons
    ReasonCode           = M.MaskedReasonCode,
    VisitReason          = M.MaskedVisitReason,
    SNOMEDCT             = M.MaskedSNOMEDCT,
    DRG                  = M.MaskedDRG,
    CPT                  = M.MaskedCPT,
    [CPT Modifiers]      = M.MaskedCPTModifiers,
    ICD10                = M.MaskedICD10,

    -- insurance / coverage
    FinancialClass         = M.MaskedFinancialClass,
    PrimaryHealthPlanName  = M.MaskedPrimaryHealthPlanName,
    PrimaryMemberNumber    = M.MaskedPrimaryMemberNumber,
    PrimaryGroupNumber     = M.MaskedPrimaryGroupNumber,
    SecondaryHealthPlanName= M.MaskedSecondaryHealthPlanName,
    SecondaryMemberNumber  = M.MaskedSecondaryMemberNumber,
    SecondaryGroupNumber   = M.MaskedSecondaryGroupNumber
FROM S_cdpdynamics.CDP_ENCOUNTERS AS E
CROSS APPLY
(
    SELECT ABS(CHECKSUM(E.EncounterId)) AS Seed
) AS S
CROSS APPLY
(
    SELECT
        ------------------------------------------------------------
        -- NUMERIC TOKENS (safe for INT or VARCHAR)
        ------------------------------------------------------------
        CAST(ABS(CHECKSUM('MRN', S.Seed)) AS BIGINT)            AS MaskedMRN,
        CAST(ABS(CHECKSUM('EncId', S.Seed)) AS BIGINT)          AS MaskedEncounterId,
        CAST(ABS(CHECKSUM('EncLine', S.Seed)) AS BIGINT)        AS MaskedEncounterLine,

        -- codes (as INT tokens)
        CAST(1000 + (S.Seed % 9000) AS INT)                     AS MaskedReasonCode,
        CAST(2000 + (S.Seed % 9000) AS INT)                     AS MaskedDRG,
        CAST(3000 + (S.Seed % 9000) AS INT)                     AS MaskedCPT,
        CAST(4000 + (S.Seed % 9000) AS INT)                     AS MaskedCPTModifiers,
        CAST(5000 + (S.Seed % 9000) AS INT)                     AS MaskedICD10,
        CAST(ABS(CHECKSUM('FinClass', S.Seed)) AS INT)          AS MaskedFinancialClass,

        -- member/group numbers
        CAST(ABS(CHECKSUM('P-Mem', S.Seed)) AS BIGINT)          AS MaskedPrimaryMemberNumber,
        CAST(ABS(CHECKSUM('P-Grp', S.Seed)) AS BIGINT)          AS MaskedPrimaryGroupNumber,
        CAST(ABS(CHECKSUM('S-Mem', S.Seed)) AS BIGINT)          AS MaskedSecondaryMemberNumber,
        CAST(ABS(CHECKSUM('S-Grp', S.Seed)) AS BIGINT)          AS MaskedSecondaryGroupNumber,

        ------------------------------------------------------------
        -- TEXT VALUES (realistic/generic)
        ------------------------------------------------------------
        'General consultation (masked)'                         AS MaskedVisitReason,
        'SNOMED_MASKED_' + CAST(S.Seed % 100000 AS VARCHAR(6))  AS MaskedSNOMEDCT,
        'Health Plan A (masked)'                                AS MaskedPrimaryHealthPlanName,
        'Health Plan B (masked)'                                AS MaskedSecondaryHealthPlanName,

        ------------------------------------------------------------
        -- DATES / TIMES (deterministic shift)
        ------------------------------------------------------------
        DATEADD(DAY, (S.Seed % 365),
            ISNULL(E.EncounterDate, CAST('2018-01-01' AS DATE))
        ) AS MaskedEncounterDate,

        DATEADD(DAY, (S.Seed % 365),
            ISNULL(E.AdmissionDateTime, CAST('2018-01-01' AS DATETIME2))
        ) AS MaskedAdmissionDateTime,

        DATEADD(DAY, (S.Seed % 365),
            ISNULL(E.DischargeDateTime, CAST('2018-01-02' AS DATETIME2))
        ) AS MaskedDischargeDateTime,

        DATEADD(DAY, (S.Seed % 365),
            ISNULL(E.EpicEncountersCreatedOn, CAST('2018-01-01' AS DATETIME2))
        ) AS MaskedEpicEncountersCreatedOn
) AS M;
GO
