USE TERA;
GO

/*========================================================
  STATIC MASKING (CRITICAL FIELDS)
  TABLE : TERA.S_cdpdynamics.CDP_APPOINTMENTS
  SEED  : AppointmentID
=========================================================*/

UPDATE A
SET
    -- Patient identifiers
    PatientFirstName       = M.MaskedFirstName,
    PatientLastName        = M.MaskedLastName,
    MRN                    = M.MaskedMRN,
    PatientEmailAddress    = M.MaskedEmail,

    -- Address
    PatientHomeAddress1       = M.MaskedAddress1,
    PatientHomeAddressCity    = M.MaskedCity,
    PatientHomeAddressZipcode = M.MaskedZip,

    -- Phones (mask both possible work phone columns)
    HomePhone   = M.MaskedHomePhone,
    WorkPhone   = M.MaskedWorkPhone,
    [Work Phone]= M.MaskedWorkPhone,
    MobilePhone = M.MaskedMobilePhone,

    -- DOB
    PatientDateofBirth = M.MaskedDOB,

    -- Visit / appointment reason (codes and text)
    VisitReasonCode        = M.MaskedVisitReasonCode,
    VisitReasonDescription = M.MaskedVisitReasonDesc,

    -- Appointment details
    AppointmentDescription = M.MaskedApptDesc,
    AppointmentTypeCode    = M.MaskedApptTypeCode,
    AppointmentComment     = M.MaskedApptComment,

    -- Insurance
    PrimaryHealthPlanName   = M.MaskedPrimaryPlan,
    SecondaryHealthPlanName = M.MaskedSecondaryPlan,

    -- IDs / join keys (tokenize but DO NOT touch AppointmentID itself)
    VisitencounterID     = M.MaskedVisitEncounterID,
    Visit_Encounters_ID  = M.MaskedVisitEpicEncountersID,
    EpicAppointmentsID   = M.MaskedEpicAppointmentsID,

    -- Referral
    Referralcode         = M.MaskedReferralCode,
    Referralcreatedondate= M.MaskedReferralCreatedOn,

    -- Dates / times of care
    EncounterDate        = M.MaskedEncounterDate,
    AppointmentDate      = M.MaskedAppointmentDate,
    AppointmentStartTime = M.MaskedStartTime,
    AppointmentEndTime   = M.MaskedEndTime
FROM TERA.S_cdpdynamics.CDP_APPOINTMENTS AS A
CROSS APPLY
(
    SELECT ABS(CHECKSUM(A.AppointmentID)) AS Seed
) AS S
CROSS APPLY
(
    SELECT
        ------------------------------------------------------------
        -- NAMES (realistic text)
        ------------------------------------------------------------
        CASE S.Seed % 10
            WHEN 0 THEN 'James'
            WHEN 1 THEN 'Mary'
            WHEN 2 THEN 'Robert'
            WHEN 3 THEN 'Patricia'
            WHEN 4 THEN 'John'
            WHEN 5 THEN 'Jennifer'
            WHEN 6 THEN 'Michael'
            WHEN 7 THEN 'Linda'
            WHEN 8 THEN 'David'
            ELSE 'Sarah'
        END AS MaskedFirstName,

        CASE (S.Seed / 10) % 10
            WHEN 0 THEN 'Smith'
            WHEN 1 THEN 'Johnson'
            WHEN 2 THEN 'Brown'
            WHEN 3 THEN 'Williams'
            WHEN 4 THEN 'Jones'
            WHEN 5 THEN 'Garcia'
            WHEN 6 THEN 'Miller'
            WHEN 7 THEN 'Davis'
            WHEN 8 THEN 'Lopez'
            ELSE 'Taylor'
        END AS MaskedLastName,

        ------------------------------------------------------------
        -- MRN + IDs (numeric tokens safe for INT or VARCHAR)
        ------------------------------------------------------------
        CAST(ABS(CHECKSUM('MRN', S.Seed)) AS BIGINT)        AS MaskedMRN,
        CAST(ABS(CHECKSUM('VEID', S.Seed)) AS BIGINT)       AS MaskedVisitEncounterID,
        CAST(ABS(CHECKSUM('VEEID', S.Seed)) AS BIGINT)      AS MaskedVisitEpicEncountersID,
        CAST(ABS(CHECKSUM('EAID', S.Seed)) AS BIGINT)       AS MaskedEpicAppointmentsID,

        ------------------------------------------------------------
        -- Address (text) + ZIP numeric
        ------------------------------------------------------------
        CASE S.Seed % 5
            WHEN 0 THEN '123 Main St'
            WHEN 1 THEN '456 Oak Ave'
            WHEN 2 THEN '789 Pine Road'
            WHEN 3 THEN '321 Maple Drive'
            ELSE '654 Elm Street'
        END AS MaskedAddress1,

        CASE (S.Seed / 5) % 5
            WHEN 0 THEN 'Houston'
            WHEN 1 THEN 'Dallas'
            WHEN 2 THEN 'Austin'
            WHEN 3 THEN 'San Antonio'
            ELSE 'Fort Worth'
        END AS MaskedCity,

        CAST(10000 + (S.Seed % 90000) AS INT) AS MaskedZip,

        ------------------------------------------------------------
        -- Phones: 10-digit strings (safe for varchar or numeric)
        ------------------------------------------------------------
        RIGHT('0000000000' + CAST(ABS(CHECKSUM('H', S.Seed)) AS VARCHAR(10)), 10) AS MaskedHomePhone,
        RIGHT('0000000000' + CAST(ABS(CHECKSUM('W', S.Seed)) AS VARCHAR(10)), 10) AS MaskedWorkPhone,
        RIGHT('0000000000' + CAST(ABS(CHECKSUM('M', S.Seed)) AS VARCHAR(10)), 10) AS MaskedMobilePhone,

        ------------------------------------------------------------
        -- Email (realistic text)
        ------------------------------------------------------------
        LOWER(
            CASE S.Seed % 10
                WHEN 0 THEN 'james'
                WHEN 1 THEN 'mary'
                WHEN 2 THEN 'robert'
                WHEN 3 THEN 'patricia'
                WHEN 4 THEN 'john'
                WHEN 5 THEN 'jennifer'
                WHEN 6 THEN 'michael'
                WHEN 7 THEN 'linda'
                WHEN 8 THEN 'david'
                ELSE 'sarah'
            END + '.' +
            CASE (S.Seed / 10) % 10
                WHEN 0 THEN 'smith'
                WHEN 1 THEN 'johnson'
                WHEN 2 THEN 'brown'
                WHEN 3 THEN 'williams'
                WHEN 4 THEN 'jones'
                WHEN 5 THEN 'garcia'
                WHEN 6 THEN 'miller'
                WHEN 7 THEN 'davis'
                WHEN 8 THEN 'lopez'
                ELSE 'taylor'
            END + '@examplemail.com'
        ) AS MaskedEmail,

        ------------------------------------------------------------
        -- DOB (date)
        ------------------------------------------------------------
        DATEFROMPARTS(
            1940 + (S.Seed % 60),
            1 + ((S.Seed / 100) % 12),
            1 + ((S.Seed / 1000) % 28)
        ) AS MaskedDOB,

        ------------------------------------------------------------
        -- Reason codes & descriptions
        ------------------------------------------------------------
        CAST(1000 + (S.Seed % 9000) AS INT) AS MaskedVisitReasonCode,
        'General consultation (masked)'     AS MaskedVisitReasonDesc,

        ------------------------------------------------------------
        -- Appointment fields (type/code numeric token + text desc)
        ------------------------------------------------------------
        CAST(10 + (S.Seed % 90) AS INT)      AS MaskedApptTypeCode,
        'Routine visit (masked)'             AS MaskedApptDesc,

        -- AppointmentComment can be INT in some environments; use numeric token
        CAST(100000 + (S.Seed % 900000) AS INT) AS MaskedApptComment,

        ------------------------------------------------------------
        -- Insurance (text)
        ------------------------------------------------------------
        'Health Plan A (masked)' AS MaskedPrimaryPlan,
        'Health Plan B (masked)' AS MaskedSecondaryPlan,

        ------------------------------------------------------------
        -- Referral (Referralcode can be numeric in some feeds; use numeric token)
        ------------------------------------------------------------
        CAST(ABS(CHECKSUM('REF', S.Seed)) AS BIGINT) AS MaskedReferralCode,
        DATEADD(DAY, (S.Seed % 365),
            ISNULL(A.Referralcreatedondate, CAST('2018-01-01' AS DATE))
        ) AS MaskedReferralCreatedOn,

        ------------------------------------------------------------
        -- Dates / times (deterministic shift)
        ------------------------------------------------------------
        DATEADD(DAY, (S.Seed % 365),
            ISNULL(A.EncounterDate, CAST('2018-01-01' AS DATE))
        ) AS MaskedEncounterDate,

        DATEADD(DAY, (S.Seed % 365),
            ISNULL(A.AppointmentDate, CAST('2018-01-01' AS DATE))
        ) AS MaskedAppointmentDate,

        TIMEFROMPARTS(8 + (S.Seed % 9), (S.Seed / 10) % 60, 0, 0, 0) AS MaskedStartTime,
        TIMEFROMPARTS(9 + (S.Seed % 9), (S.Seed / 20) % 60, 0, 0, 0) AS MaskedEndTime
) AS M;
GO


