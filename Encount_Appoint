CREATE TRIGGER S_cdpdynamics.trg_CDP_PAT_ENCOUNTERS_Masking
ON TERA.S_cdpdynamics.CDP_PAT_ENCOUNTERS
AFTER INSERT, UPDATE
AS
BEGIN
    SET NOCOUNT ON;
    IF TRIGGER_NESTLEVEL() > 1 RETURN;

    ;WITH ToMask AS
    (
        SELECT A.*
        FROM TERA.S_cdpdynamics.CDP_PAT_ENCOUNTERS A
        INNER JOIN inserted i
            ON A.EncounterId = i.EncounterId
    )
    UPDATE A
    SET
        EncounterDate        = M.MaskedEncounterDate,
        AdmissionDateTime    = M.MaskedAdmissionDT,
        DischargeDateTime    = M.MaskedDischargeDT,
        LastUpdated          = M.MaskedLastUpdated,
        EpicEncountersCreatedOn = M.MaskedEpicEncCreatedOn,

