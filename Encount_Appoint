            RIGHT('0000000000' + CAST(ABS(CHECKSUM('SURGNPI', S.Seed)) AS VARCHAR(20)), 10) AS MaskedSurgeonProvNPI,

            CAST(ABS(CHECKSUM('ACOID', S.Seed)) AS BIGINT) AS MaskedACORegID,
            CAST(ABS(CHECKSUM('ACONM', S.Seed)) AS BIGINT) AS MaskedACORegName,

            RIGHT('0000000000' + CAST(ABS(CHECKSUM('PCPHYSNPI', S.Seed)) AS VARCHAR(20)), 10) AS MaskedPrimaryCarePhysNPI,
            CAST(ABS(CHECKSUM('PATPCP', S.Seed)) AS BIGINT) AS MaskedPatientPCPValue
    ) AS M;
END;
