            RIGHT('0000000000' + CAST(ABS(CHECKSUM('ATTNPI', S.Seed)) AS VARCHAR(20)), 10) AS MaskedAttendingProvNPI,

            CAST(ABS(CHECKSUM('ORDID', S.Seed)) AS BIGINT) AS MaskedOrderingProvID,
