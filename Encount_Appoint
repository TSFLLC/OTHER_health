            RIGHT('0000000000' + CAST(ABS(CHECKSUM('FUPNPI', S.Seed)) AS VARCHAR(20)), 10) AS MaskedFollowupProvNPI,

            CAST(ABS(CHECKSUM('SURGID', S.Seed)) AS BIGINT) AS MaskedSurgeonProvID,
