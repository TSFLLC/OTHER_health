        DischargeProviderNPI    = M.MaskedDischargeProvNPI,

        [Follow-upProviderID]   = M.MaskedFollowupProvID,
        [Follow-upProviderName] = M.MaskedFollowupProvValue,
        [Follow-upProviderNPI]  = M.MaskedFollowupProvNPI,

        SurgeonProviderID       = M.MaskedSurgeonProvID,
        SurgeonProviderName     = M.MaskedSurgeonProvValue,
        SurgeonProviderNPI      = M.MaskedSurgeonProvNPI,

        ACORegistryID       = M.MaskedACORegID,
        ACORegistryName     = M.MaskedACORegName,

        PrimaryCarePhysicianNPI     = M.MaskedPrimaryCarePhysNPI,
        PatientPrimaryCarePhysician = M.MaskedPatientPCPValue

        -- NOTE: MRN NOT MASKED
    FROM ToMask A
    CROSS APPLY
    (
        SELECT ABS(CHECKSUM(COALESCE(CONVERT(VARCHAR(100), A.EncounterId), A.MRN))) AS Seed
    ) AS S
    CROSS APPLY
    (
        /* Reuse the EXACT same masking logic as static update */
        SELECT
            DATEADD(DAY, (S.Seed % 365), ISNULL(CAST(A.EncounterDate AS DATETIME), CAST('2018-01-01' AS DATETIME))) AS MaskedEncounterDate,
            DATEADD(DAY, (S.Seed % 365), ISNULL(CAST(A.AdmissionDateTime AS DATETIME), CAST('2018-01-01' AS DATETIME))) AS MaskedAdmissionDT,
