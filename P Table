UPDATE p
SET
    -- DOB: between 1940 and ~2010
    DateofBirth =
        DATEADD(
            DAY,
            ABS(CHECKSUM(CONVERT(varchar(30), p.PAT_ENC_CSN_ID))) % 25550,
            CONVERT(date, '1940-01-01')
        ),

    -- Address 1 Street 1
    [Address 1: Street 1] =
        CAST(100 + (ABS(CHECKSUM(CONVERT(varchar(30), p.PAT_ENC_CSN_ID) + '_S1')) % 9000) AS varchar(5))
        + ' '
        + CASE ABS(CHECKSUM(CONVERT(varchar(30), p.PAT_ENC_CSN_ID) + '_S1NAME')) % 5
              WHEN 0 THEN 'Oak St'
              WHEN 1 THEN 'Maple Ave'
              WHEN 2 THEN 'Pine Dr'
              WHEN 3 THEN 'Cedar Ln'
              WHEN 4 THEN 'Elm St'
          END,

    -- Address 2 Street 2
    [Address 2: Street 2] =
        CASE WHEN ABS(CHECKSUM(CONVERT(varchar(30), p.PAT_ENC_CSN_ID) + '_APTFLAG')) % 3 = 0
             THEN 'Apt ' +
                  CAST(1 + (ABS(CHECKSUM(CONVERT(varchar(30), p.PAT_ENC_CSN_ID) + '_APT')) % 200) AS varchar(4))
             ELSE 'Suite ' +
                  CAST(1 + (ABS(CHECKSUM(CONVERT(varchar(30), p.PAT_ENC_CSN_ID) + '_SUITE')) % 300) AS varchar(4))
        END,

    -- City
    [Address 1: City] =
        CASE ABS(CHECKSUM(CONVERT(varchar(30), p.PAT_ENC_CSN_ID) + '_CITY')) % 6
