USE [TERA];
GO

/* ====== 0) Ensure schema exists for governance objects ====== */
IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = N'B_hipaattizer')
    EXEC(N'CREATE SCHEMA [B_hipaattizer] AUTHORIZATION [dbo];');
GO

/* ====== 1) Backfill (static masking) existing rows ======
   Mask rules:
   - Numeric IDs -> deterministic pseudo-number via CHECKSUM
   - String IDs  -> keep last 4 chars, replace rest with X
   - GUIDs       -> deterministic GUID derived from MD5
*/

UPDATE T
SET
    PatEncCsnId =
        CASE
            WHEN TRY_CONVERT(bigint, T.PatEncCsnId) IS NOT NULL
                THEN CONVERT(bigint, ABS(CHECKSUM(CONCAT(CONVERT(varchar(50), T.PatEncCsnId), '|CSN'))))
            WHEN TRY_CONVERT(uniqueidentifier, T.PatEncCsnId) IS NOT NULL
                THEN TRY_CONVERT(uniqueidentifier,
                    STUFF(STUFF(STUFF(STUFF(
                        LOWER(CONVERT(varchar(32), HASHBYTES('MD5', CONVERT(varbinary(16), TRY_CONVERT(uniqueidentifier, T.PatEncCsnId))), 2)),
                        9, 0, '-'), 14, 0, '-'), 19, 0, '-'), 24, 0, '-')
                )
            ELSE
                REPLICATE('X', CASE WHEN LEN(CONVERT(nvarchar(4000), T.PatEncCsnId)) > 4 THEN LEN(CONVERT(nvarchar(4000), T.PatEncCsnId)) - 4 ELSE 0 END)
                + RIGHT(CONVERT(nvarchar(4000), T.PatEncCsnId), 4)
        END,

    PatId =
        CASE
            WHEN TRY_CONVERT(bigint, T.PatId) IS NOT NULL
                THEN CONVERT(bigint, ABS(CHECKSUM(CONCAT(CONVERT(varchar(50), T.PatId), '|PAT'))))
            WHEN TRY_CONVERT(uniqueidentifier, T.PatId) IS NOT NULL
                THEN TRY_CONVERT(uniqueidentifier,
                    STUFF(STUFF(STUFF(STUFF(
                        LOWER(CONVERT(varchar(32), HASHBYTES('MD5', CONVERT(varbinary(16), TRY_CONVERT(uniqueidentifier, T.PatId))), 2)),
                        9, 0, '-'), 14, 0, '-'), 19, 0, '-'), 24, 0, '-')
                )
            ELSE
                REPLICATE('X', CASE WHEN LEN(CONVERT(nvarchar(4000), T.PatId)) > 4 THEN LEN(CONVERT(nvarchar(4000), T.PatId)) - 4 ELSE 0 END)
                + RIGHT(CONVERT(nvarchar(4000), T.PatId), 4)
        END,

    ReferralId =
        CASE
            WHEN TRY_CONVERT(bigint, T.ReferralId) IS NOT NULL
                THEN CONVERT(bigint, ABS(CHECKSUM(CONCAT(CONVERT(varchar(50), T.ReferralId), '|REF'))))
            WHEN TRY_CONVERT(uniqueidentifier, T.ReferralId) IS NOT NULL
                THEN TRY_CONVERT(uniqueidentifier,
                    STUFF(STUFF(STUFF(STUFF(
                        LOWER(CONVERT(varchar(32), HASHBYTES('MD5', CONVERT(varbinary(16), TRY_CONVERT(uniqueidentifier, T.ReferralId))), 2)),
                        9, 0, '-'), 14, 0, '-'), 19, 0, '-'), 24, 0, '-')
                )
            ELSE
                REPLICATE('X', CASE WHEN LEN(CONVERT(nvarchar(4000), T.ReferralId)) > 4 THEN LEN(CONVERT(nvarchar(4000), T.ReferralId)) - 4 ELSE 0 END)
                + RIGHT(CONVERT(nvarchar(4000), T.ReferralId), 4)
        END
FROM [B_epic].[VSchedAppt] T;
GO


