/* ====== Trigger: keep critical fields masked on INSERT/UPDATE ======
   Optional ETL bypass:
     EXEC sys.sp_set_session_context @key=N'BYPASS_MASKING', @value=1;
*/

CREATE OR ALTER TRIGGER [B_hipaattizer].[trg_mask_VSchedAppt_Critical]
ON [B_epic].[VSchedAppt]
AFTER INSERT, UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    -- Allow SSIS/ETL or approved jobs to bypass masking
    IF TRY_CONVERT(int, SESSION_CONTEXT(N'BYPASS_MASKING')) = 1
        RETURN;

    UPDATE T
    SET
        PatEncCsnId =
            CASE
                WHEN TRY_CONVERT(bigint, i.PatEncCsnId) IS NOT NULL
                    THEN CONVERT(bigint, ABS(CHECKSUM(CONCAT(CONVERT(varchar(50), i.PatEncCsnId), '|CSN'))))
                WHEN TRY_CONVERT(uniqueidentifier, i.PatEncCsnId) IS NOT NULL
                    THEN TRY_CONVERT(uniqueidentifier,
                        STUFF(STUFF(STUFF(STUFF(
                            LOWER(CONVERT(varchar(32), HASHBYTES('MD5', CONVERT(varbinary(16), TRY_CONVERT(uniqueidentifier, i.PatEncCsnId))), 2)),
                            9, 0, '-'), 14, 0, '-'), 19, 0, '-'), 24, 0, '-')
                    )
                ELSE
                    REPLICATE('X', CASE WHEN LEN(CONVERT(nvarchar(4000), i.PatEncCsnId)) > 4 THEN LEN(CONVERT(nvarchar(4000), i.PatEncCsnId)) - 4 ELSE 0 END)
                    + RIGHT(CONVERT(nvarchar(4000), i.PatEncCsnId), 4)
            END,

        PatId =
            CASE
                WHEN TRY_CONVERT(bigint, i.PatId) IS NOT NULL
                    THEN CONVERT(bigint, ABS(CHECKSUM(CONCAT(CONVERT(varchar(50), i.PatId), '|PAT'))))
                WHEN TRY_CONVERT(uniqueidentifier, i.PatId) IS NOT NULL
                    THEN TRY_CONVERT(uniqueidentifier,
                        STUFF(STUFF(STUFF(STUFF(
                            LOWER(CONVERT(varchar(32), HASHBYTES('MD5', CONVERT(varbinary(16), TRY_CONVERT(uniqueidentifier, i.PatId))), 2)),
                            9, 0, '-'), 14, 0, '-'), 19, 0, '-'), 24, 0, '-')
                    )
                ELSE
                    REPLICATE('X', CASE WHEN LEN(CONVERT(nvarchar(4000), i.PatId)) > 4 THEN LEN(CONVERT(nvarchar(4000), i.PatId)) - 4 ELSE 0 END)
                    + RIGHT(CONVERT(nvarchar(4000), i.PatId), 4)
            END,

        ReferralId =
            CASE
                WHEN TRY_CONVERT(bigint, i.ReferralId) IS NOT NULL
                    THEN CONVERT(bigint, ABS(CHECKSUM(CONCAT(CONVERT(varchar(50), i.ReferralId), '|REF'))))
                WHEN TRY_CONVERT(uniqueidentifier, i.ReferralId) IS NOT NULL
                    THEN TRY_CONVERT(uniqueidentifier,
                        STUFF(STUFF(STUFF(STUFF(
                            LOWER(CONVERT(varchar(32), HASHBYTES('MD5', CONVERT(varbinary(16), TRY_CONVERT(uniqueidentifier, i.ReferralId))), 2)),
                            9, 0, '-'), 14, 0, '-'), 19, 0, '-'), 24, 0, '-')
                    )
                ELSE
                    REPLICATE('X', CASE WHEN LEN(CONVERT(nvarchar(4000), i.ReferralId)) > 4 THEN LEN(CONVERT(nvarchar(4000), i.ReferralId)) - 4 ELSE 0 END)
                    + RIGHT(CONVERT(nvarchar(4000), i.ReferralId), 4)
            END
    FROM [B_epic].[VSchedAppt] T
    INNER JOIN inserted i
        ON T.PatEncCsnId = i.PatEncCsnId;   -- assumes CSN identifies the row
END;
GO


