    SET @set += @comma + QUOTENAME(@cRHP) + N' =
        ''555'' + RIGHT(''0000000'' + CAST(ABS(CAST(CHECKSUM(s.Seed + ''_RHP'') AS BIGINT)) % 10000000 AS varchar(7)), 7)';
    SET @comma = N', ';
