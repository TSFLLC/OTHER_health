IF @cRMP IS NOT NULL
BEGIN
    SET @set += @comma + QUOTENAME(@cRMP) + N' =
        ''555'' + RIGHT(''0000000'' + CAST(ABS(CAST(CHECKSUM(s.Seed + ''_RMP'') AS BIGINT)) % 10000000 AS varchar(7)), 7)';
    SET @comma = N', ';
