    + N'COALESCE(CONVERT(varchar(30),  ' + CASE WHEN @cDOB IS NOT NULL THEN N'p.' + QUOTENAME(@cDOB) ELSE N'NULL' END + N', 120), '''')'
    + N')), '''')';

