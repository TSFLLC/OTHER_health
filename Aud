Daily Audit Report (last 24 hours) — TERA
DECLARE @AuditPath NVARCHAR(4000) = N'E:\SQLAudit\TERA\*.sqlaudit';
DECLARE @Since DATETIME2(0) = DATEADD(DAY, -1, SYSDATETIME());

SELECT
    event_time,
    CASE action_id
        WHEN 'DR'   THEN 'DROP (DDL)'
        WHEN 'CR'   THEN 'CREATE (DDL)'
        WHEN 'AL'   THEN 'ALTER (DDL)'
        WHEN 'LGIS' THEN 'LOGIN SUCCESS'
        WHEN 'LGIF' THEN 'LOGIN FAILED'
        ELSE action_id
    END AS EventType,
    server_principal_name  AS LoginName,
    database_name,
    schema_name,
    object_name,
    client_ip,
    application_name,
    succeeded,
    statement
FROM sys.fn_get_audit_file(@AuditPath, NULL, NULL)
WHERE event_time >= @Since
  AND (
        database_name = 'TERA'
        OR action_id IN ('LGIS','LGIF')   -- logins are server-level; no db name
      )
  AND action_id IN ('DR','CR','AL','LGIS','LGIF')
ORDER BY event_time DESC;
