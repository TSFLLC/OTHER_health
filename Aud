schedule time (example below is 07:00 AM)++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++//*

USE msdb;
GO

DECLARE @JobName sysname = N'TERA - Daily SQL Audit Report';
DECLARE @AuditPath nvarchar(4000) = N'E:\SQLAudit\TERA\*.sqlaudit';
DECLARE @OperatorEmail nvarchar(4000) = N'your.email@company.com';  -- <-- change

/* 1) Create the job */
IF NOT EXISTS (SELECT 1 FROM msdb.dbo.sysjobs WHERE name = @JobName)
BEGIN
    EXEC msdb.dbo.sp_add_job
        @job_name = @JobName,
        @enabled = 1,
        @description = N'Runs daily SQL Audit report for TERA, stores to table, emails summary + top events.',
        @category_name = N'Database Maintenance';
END
GO

/* 2) Add job step */
IF NOT EXISTS
(
    SELECT 1
    FROM msdb.dbo.sysjobsteps s
    JOIN msdb.dbo.sysjobs j ON j.job_id = s.job_id
    WHERE j.name = N'TERA - Daily SQL Audit Report'
      AND s.step_name = N'Run Audit Report'
)
BEGIN
    EXEC msdb.dbo.sp_add_jobstep
        @job_name = N'TERA - Daily SQL Audit Report',
        @step_name = N'Run Audit Report',
        @subsystem = N'TSQL',
        @database_name = N'TERA',
        @command = N'
DECLARE @AuditPath nvarchar(4000) = N''' + REPLACE(@AuditPath,'''','''''') + N''';
DECLARE @Recipients nvarchar(4000) = N''' + REPLACE(@OperatorEmail,'''','''''') + N''';

EXEC dbo.usp_RunDailyAuditReport_TERA
      @AuditPath = @AuditPath
    , @LookbackHours = 24
    , @MailProfile = NULL
    , @Recipients = @Recipients;
';
END
GO

/* 3) Daily schedule at 07:00 AM */
IF NOT EXISTS
(
    SELECT 1
    FROM msdb.dbo.sysschedules
    WHERE name = N'TERA - Daily SQL Audit Report - 7AM'
)
BEGIN
    EXEC msdb.dbo.sp_add_schedule
        @schedule_name = N'TERA - Daily SQL Audit Report - 7AM',
        @enabled = 1,
        @freq_type = 4,             -- daily
        @freq_interval = 1,         -- every day
        @active_start_time = 070000;-- 07:00:00
END
GO

/* Attach schedule to job */
EXEC msdb.dbo.sp_attach_schedule
    @job_name = N'TERA - Daily SQL Audit Report',
    @schedule_name = N'TERA - Daily SQL Audit Report - 7AM';
GO

/* Add job to local server */
EXEC msdb.dbo.sp_add_jobserver
    @job_name = N'TERA - Daily SQL Audit Report';
GO


