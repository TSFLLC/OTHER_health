;WITH MaskSeed AS
(
    SELECT
        sid,
        -- Use different CHECKSUM salts instead of multiplying GUID
        ABS(CHECKSUM(sid, 1)) AS Seed1,
        ABS(CHECKSUM(sid, 2)) AS Seed2,
        ABS(CHECKSUM(sid, 3)) AS Seed3
    FROM [B_hipaatizer].[sub_23e30401_a88f_4482_96c3_cdf57dbad4f2]
)
UPDATE T
SET
    -- fake first name: First12345
    first_name = CONCAT(
                         'First',
                         RIGHT('00000' + CAST(Seed1 % 100000 AS varchar(5)), 5)
                       ),

    -- fake last name: Last67890
    last_name  = CONCAT(
                         'Last',
                         RIGHT('00000' + CAST(Seed2 % 100000 AS varchar(5)), 5)
                       ),

    -- fake but valid-looking email: user12345@example.com
    email      = CONCAT(
                         'user',
                         RIGHT('00000' + CAST(Seed3 % 100000 AS varchar(5)), 5),
                         '@example.com'
                       ),

    -- fake US-style phone: 555-123-4567
    phone      = CONCAT(
                         '555-',
                         RIGHT('000'  + CAST(Seed2 % 1000  AS varchar(3)), 3),
                         '-',
                         RIGHT('0000' + CAST(Seed3 % 10000 AS varchar(4)), 4)
                       )
FROM [B_hipaatizer].[sub_23e30401_a88f_4482_96c3_cdf57dbad4f2] AS T
JOIN MaskSeed AS S
    ON T.sid = S.sid;
